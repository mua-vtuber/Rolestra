#!/usr/bin/env bash
# R12-C2 T11 + T41 — pre-push inspector hook (전체 inspector 실행).
#
# T41 이후 phase 2 로 돈다. 안전 7 카테고리 위반이 있으면 목록이 그대로
# 보이고, 그것으로 push 를 막을지는 `tools/inspectors/config.ts` 의
# `failClosed` 가 정한다:
#
#   failClosed = false (현재 기본)  목록만 보여 주고 push 는 통과.
#   failClosed = true               위반이 있으면 push 가 막힌다.
#
# 전환은 사용자 승인 게이트다 (계획서 P7 T41). 이 훅은 값을 읽기만 하고
# 스스로 켜지 않는다.
#
# WP11c 항목 5 — 막는 조건과 안 막는 조건.
#
# 예전에는 `set -e` 아래에서 검사기를 그냥 불렀다. 그래서 검사기 *자체가
# 죽으면* (tsx 실패, 문법 오류, 의존성 깨짐) failClosed 가 꺼져 있어도
# push 가 막혔다. "지금은 목록만 보여 준다" 던 약속이 검사기 사고 한 번에
# 뒤집히는 셈이라, 사용자는 자기 변경과 무관한 이유로 밀려난다.
#
# 지금은 두 경우를 갈라 본다. 판정의 근거는 exit code 가 아니라 검사기가
# 남긴 report 다 — 사고로 죽은 것과 위반으로 1 을 낸 것이 exit code 만으로는
# 구분되지 않기 때문이다.
#
#   1. report 가 남았고 buildShouldFail=true  → 진짜 위반. push 를 막는다.
#      (buildShouldFail 은 failClosed 가 켜져 있고 안전 hit 이 있을 때만
#       true 다 — run.ts 가 그렇게 만든다.)
#   2. report 가 없거나 읽히지 않는다 → 검사기가 죽은 것. 무슨 일이
#      있었는지 그대로 찍고 push 는 통과시킨다.
#
# 한 번만 켠 채로 미리 보기: ROLESTRA_INSPECTOR_FAIL_CLOSED=1 git push
#
# 우회: `git push --no-verify`.
set -u

if ! command -v npx >/dev/null 2>&1; then
  exit 0
fi

REPORT="tools/inspectors/report.json"

echo "[inspector] pre-push — 전체 검사 (phase 2)"

# 지난 실행이 남긴 report 를 지우고 시작한다. 남겨 두면 이번 실행이
# 죽었는데도 옛 report 를 이번 결과로 읽게 된다.
rm -f "$REPORT"

set +e
npx tsx tools/inspectors/run.ts --phase=2 --report="$REPORT"
INSPECTOR_STATUS=$?
set -e

# report 를 읽어 buildShouldFail 하나만 본다. 못 읽으면 빈 문자열이 되고,
# 그 경우는 아래에서 "검사기가 죽었다" 로 다룬다.
BUILD_SHOULD_FAIL=$(node -e '
  const fs = require("node:fs");
  try {
    const report = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    process.stdout.write(report.buildShouldFail === true ? "true" : "false");
  } catch {
    process.stdout.write("");
  }
' "$REPORT" 2>/dev/null || true)

if [ "$BUILD_SHOULD_FAIL" = "true" ]; then
  echo "[inspector] 안전 카테고리 위반으로 push 를 막습니다 (failClosed=true)."
  echo "[inspector] 목록: $REPORT"
  exit 1
fi

if [ -z "$BUILD_SHOULD_FAIL" ]; then
  echo "[inspector] 검사기가 결과를 남기지 못했습니다 (exit ${INSPECTOR_STATUS})."
  echo "[inspector] 검사 결과와 무관한 사고이므로 push 는 그대로 진행합니다."
  echo "[inspector] 위 출력에 원인이 있습니다 — 검사기를 고쳐 주세요."
  exit 0
fi

exit 0
